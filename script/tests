#!/usr/bin/env python3
import os
import subprocess
from pathlib import Path
import sys

_DIR = Path(__file__).parent
_PROGRAM_DIR = _DIR.parent
_VENV_DIR = _PROGRAM_DIR / ".venv"
_TESTS_DIR = _PROGRAM_DIR / "tests" / "unit"

_TEST_DIRS = [_TESTS_DIR]

if _VENV_DIR.exists():
    python_exe = str(_VENV_DIR / "bin" / "python3")
else:
    python_exe = "python3"


env = os.environ.copy()
if sys.platform == "darwin":
    env.setdefault("DYLD_FALLBACK_LIBRARY_PATH", f"{Path.home() / 'lib'}:/opt/homebrew/lib:/usr/local/lib:/usr/lib")

subprocess.check_call([python_exe, "-m", "pytest"] + _TEST_DIRS, env=env)

