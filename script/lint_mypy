#!/usr/bin/env python3
import subprocess
from pathlib import Path
import sys

_DIR = Path(__file__).parent
_PROGRAM_DIR = _DIR.parent
_VENV_DIR = _PROGRAM_DIR / ".venv"
_MODULE_DIR = _PROGRAM_DIR / "linux_voice_assistant"
_TEST_DIRS = _PROGRAM_DIR / "tests"

_LINT_DIRS = [_MODULE_DIR, _TEST_DIRS]

if _VENV_DIR.exists():
    python_exe = str(_VENV_DIR / "bin" / "python3")
else:
    python_exe = "python3"

# Mypy Ausführung
subprocess.check_call([python_exe, "-m", "mypy"] + _LINT_DIRS)
